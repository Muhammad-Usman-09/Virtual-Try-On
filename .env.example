# ============================================================
# .env — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub!
# ============================================================

# Flask
SECRET_KEY=your-secret-key-change-this-abc123xyz
DEBUG=True

# Database (SQLite is default — no setup needed for local dev)
# For PostgreSQL: postgresql://username:password@localhost:5432/tryon_db
DATABASE_URL=sqlite:///tryon.db

# Cloudinary (optional — for cloud image storage)
# Get free account at cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
